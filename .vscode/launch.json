{

    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open index.html (Chrome - No Server Needed)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Open index.html (Edge - No Server Needed)",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Launch Chrome (VS Code Live Server - Port 5500)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}